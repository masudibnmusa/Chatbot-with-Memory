# LLM (anthropic or openai)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Embeddings (local or openai)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Memory behavior
TOP_K=5
WINDOW_SIZE=10
MIN_SIMILARITY=0.3
DUPLICATE_THRESHOLD=0.95
CONSOLIDATION_CANDIDATE_THRESHOLD=0.5
MIN_IMPORTANCE_TO_STORE=3
EXTRACT_EVERY_N_TURNS=1
ASYNC_EXTRACTION=true

# Scoring weights
WEIGHT_RELEVANCE=1.0
WEIGHT_RECENCY=0.3
WEIGHT_IMPORTANCE=0.3
RECENCY_HALF_LIFE_DAYS=30